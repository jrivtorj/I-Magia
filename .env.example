# ---- Navegador (Vite). Son públicas por diseño: la seguridad la da RLS en Supabase.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# ---- Servidor (Netlify Functions). NUNCA con prefijo VITE_.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Proveedor de IA: "gemini" (por defecto) u "openai"
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1

# Límite de cuentos por usuario y día (protege tu factura de IA)
DAILY_STORY_LIMIT=20
